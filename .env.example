# ─── Firebase Client SDK (NEXT_PUBLIC_*) ─────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=san-fedele-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=san-fedele-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=san-fedele-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-side) ────────────────────────
FIREBASE_ADMIN_PROJECT_ID=san-fedele-dev
FIREBASE_ADMIN_CLIENT_EMAIL=
# La private key va racchiusa tra virgolette doppie con \n letterali
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─── Firebase Storage (server) ───────────────────────────────
FIREBASE_STORAGE_BUCKET=san-fedele-dev.firebasestorage.app

# ─── Email per nodemailer (server) ───────────────────────────
# Qualsiasi server SMTP. Esempi:
#   Gmail / Google Workspace   smtp.gmail.com         587  (password per le app)
#   Aruba                      smtps.aruba.it         465
#   Register.it                authsmtp.securemail.pro 465
#   Microsoft 365              smtp.office365.com     587
#   Brevo (ex Sendinblue)      smtp-relay.brevo.com   587
# Prima del deploy: `npm run verifica-email` (aggiungi `-- --invia` per una prova vera)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
# Casella della segreteria che riceve le richieste
EMAIL_TO=
# Facoltative:
# Mittente, se diverso da EMAIL_USER (servizi con username non-email, caselle condivise)
EMAIL_FROM=
# true = TLS implicito, false = STARTTLS. Se vuota: true solo sulla porta 465
EMAIL_SECURE=

# ─── Chatbot — Gemini via Vertex AI (server) ─────────────────
# Nessuna API key: l'autenticazione avviene via Application Default
# Credentials. In locale riusa FIREBASE_ADMIN_CLIENT_EMAIL + _PRIVATE_KEY
# qui sopra, oppure esegui `gcloud auth application-default login`.
# Tutti opzionali; default in lib/chatbot/llm.ts.
GCLOUD_PROJECT=san-fedele-dev
# 'global' = endpoint multiregionale (default, ha sempre i modelli più nuovi).
# Per data-residency UE: europe-west4. Per features in anteprima: us-central1.
VERTEX_LOCATION=global
# Esempi: gemini-flash-latest (default), gemini-2.5-flash, gemini-3-flash-preview
VERTEX_MODEL=gemini-flash-latest

# ─── reCAPTCHA v3 (anti-spam sui moduli) ─────────────────────
# Chiavi da https://www.google.com/recaptcha/admin → tipo "reCAPTCHA v3".
# Se lasciate vuote la verifica viene saltata e resta solo il rate limit.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Recensioni Google (server) ───────────────────────────────
# Voto, numero di recensioni e ultime recensioni della scheda Google del centro
# (API "Places" di Google Cloud). Se vuote, la home mostra solo le recensioni
# inserite dall'admin. In produzione: la chiave come secret App Hosting,
# l'ID come `value:` in apphosting.yaml.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ─── Notifica WhatsApp alla segreteria (facoltativa) ─────────
# Per ogni richiesta, oltre alla mail, un messaggio WhatsApp al numero
# WHATSAPP_TO tramite WhatsApp Business Cloud API (Meta). Spenta finché
# manca anche una sola variabile. Istruzioni e formato del modello in
# lib/whatsapp.ts. WHATSAPP_TOKEN va caricato come secret.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=it
