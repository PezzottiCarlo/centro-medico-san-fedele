# ─── Firebase Client SDK (NEXT_PUBLIC_*) ─────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=san-fedele-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=san-fedele-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=san-fedele-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-side) ────────────────────────
FIREBASE_ADMIN_PROJECT_ID=san-fedele-dev
FIREBASE_ADMIN_CLIENT_EMAIL=
# La private key va racchiusa tra virgolette doppie con \n letterali
FIREBASE_ADMIN_PRIVATE_KEY=""

# ─── Firebase Storage (server) ───────────────────────────────
FIREBASE_STORAGE_BUCKET=san-fedele-dev.firebasestorage.app

# ─── Email per nodemailer (server) ───────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# ─── Chatbot — Gemini via Vertex AI (server) ─────────────────
# Nessuna API key: l'autenticazione avviene via Application Default
# Credentials. In locale riusa FIREBASE_ADMIN_CLIENT_EMAIL + _PRIVATE_KEY
# qui sopra, oppure esegui `gcloud auth application-default login`.
# Tutti opzionali; default in lib/chatbot/llm.ts.
GCLOUD_PROJECT=san-fedele-dev
# 'global' = endpoint multiregionale (default, ha sempre i modelli più nuovi).
# Per data-residency UE: europe-west4. Per features in anteprima: us-central1.
VERTEX_LOCATION=global
# Esempi: gemini-flash-latest (default), gemini-2.5-flash, gemini-3-flash-preview
VERTEX_MODEL=gemini-flash-latest
