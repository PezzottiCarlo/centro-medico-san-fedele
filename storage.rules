rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Immagini pubbliche del sito (medici, specialistiche, patologie, convenzioni, storia, content):
    // si possono scaricare conoscendo l'indirizzo, ma non elencare (`list`
    // mostrerebbe anche i file vecchi e mai pubblicati). Scrittura solo via
    // Admin SDK (API /api/upload).
    match /{folder}/{file=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
  }
}
