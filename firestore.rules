rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contenuti del sito. Il sito pubblico li legge solo lato server con
    // l'Admin SDK, che non passa da queste regole: dal browser li legge e
    // scrive soltanto il pannello /admin. Per questo la lettura è riservata
    // agli utenti autenticati: altrimenti chiunque, con la chiave pubblica,
    // leggerebbe anche le bozze (medici non pubblicati con telefono ed email).
    //
    // Autenticato = admin del centro: la registrazione libera è disattivata
    // in Firebase Auth (disabledUserSignup), gli account li crea il titolare.
    function isAdmin() {
      return request.auth != null;
    }

    match /specialistiche/{doc=**} { allow read, write: if isAdmin(); }
    match /medici/{doc=**} { allow read, write: if isAdmin(); }
    match /patologie/{doc=**} { allow read, write: if isAdmin(); }
    match /news_eventi/{doc=**} { allow read, write: if isAdmin(); }
    match /convenzioni/{doc=**} { allow read, write: if isAdmin(); }
    match /recensioni_statiche/{doc=**} { allow read, write: if isAdmin(); }
    match /storia_eventi/{doc=**} { allow read, write: if isAdmin(); }
    match /riconoscimenti/{doc=**} { allow read, write: if isAdmin(); }
    match /hero_config/{doc=**} { allow read, write: if isAdmin(); }
    match /site_config/{doc=**} { allow read, write: if isAdmin(); }

    // Richieste dei pazienti: si creano SOLO dall'API /api/prenota (Admin SDK).
    // Dall'admin: lettura, aggiornamento (letto/evaso) ed eliminazione, che
    // serve a rispettare le richieste di cancellazione dei dati (GDPR art. 17).
    match /leads/{doc=**} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Default deny per qualsiasi altra collezione futura
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
