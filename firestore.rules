rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contenuti pubblici del sito: lettura aperta, scrittura solo a utenti
    // autenticati (= admin loggati via Firebase Auth dal pannello /admin).
    // Per definizione, l'unico modo di essere autenticati in questo
    // progetto è essere admin del centro.
    match /specialistiche/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /medici/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /patologie/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /news_eventi/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /convenzioni/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /recensioni_statiche/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /storia_eventi/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /riconoscimenti/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /hero_config/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /site_config/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Lead form contatti / prenotazioni: la scrittura PUBBLICA passa SEMPRE
    // dall'API /api/prenota (Admin SDK lato server, che bypassa le rules).
    // Da client: lettura admin + update (per gestire stato evaso/letto).
    // Niente create/delete dal client.
    match /leads/{doc=**} {
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow create, delete: if false;
    }

    // Default deny per qualsiasi altra collezione futura
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
